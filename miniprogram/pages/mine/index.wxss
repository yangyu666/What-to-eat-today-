.mine-page {
  display: flex;
  flex-direction: column;
  gap: 30rpx;
  padding-top: 176rpx;
  background:
    linear-gradient(180deg, rgba(24, 198, 83, 0.08) 0%, rgba(246, 248, 247, 0) 300rpx),
    transparent;
}

.profile-card {
  position: relative;
  display: flex;
  align-items: center;
  gap: 26rpx;
  overflow: hidden;
  padding: 34rpx 32rpx;
  border: 1rpx solid rgba(24, 198, 83, 0.12);
  border-radius: 28rpx;
  background: #ffffff;
  box-shadow: 0 16rpx 38rpx rgba(16, 45, 32, 0.09);
}

.profile-accent {
  position: absolute;
  top: 0;
  right: 0;
  left: 0;
  height: 8rpx;
  background: linear-gradient(90deg, #18c653, #f5c84b);
}

.avatar-button {
  position: relative;
  flex: 0 0 124rpx;
  width: 124rpx;
  height: 124rpx;
  overflow: hidden;
  border: 6rpx solid #ffffff;
  border-radius: 50%;
  background: rgba(24, 198, 83, 0.1);
  box-shadow: 0 10rpx 24rpx rgba(16, 45, 32, 0.16);
}

.avatar-image,
.avatar-placeholder {
  width: 112rpx;
  height: 112rpx;
  border-radius: 50%;
}

.avatar-placeholder {
  display: flex;
  align-items: center;
  justify-content: center;
  color: #ffffff;
  font-size: 40rpx;
  font-weight: 800;
  background: linear-gradient(135deg, #18c653, #12a978);
}

.profile-main {
  flex: 1;
  min-width: 0;
}

.profile-label {
  display: inline-flex;
  margin-bottom: 10rpx;
  padding: 6rpx 14rpx;
  border-radius: 999rpx;
  color: #0f8f3e;
  font-size: 22rpx;
  font-weight: 700;
  line-height: 1.2;
  background: rgba(24, 198, 83, 0.1);
}

.nickname-input {
  width: 100%;
  height: 52rpx;
  color: var(--color-text);
  font-size: 36rpx;
  font-weight: 800;
  line-height: 52rpx;
}

.status {
  display: block;
  margin-top: 10rpx;
  color: var(--color-muted);
  font-size: 24rpx;
  line-height: 1.5;
}

.settings-section {
  display: flex;
  flex-direction: column;
  gap: 14rpx;
}

.section-heading {
  display: block;
  padding-left: 8rpx;
  color: rgba(56, 45, 35, 0.72);
  font-size: 26rpx;
  font-weight: 800;
  line-height: 1.35;
}

.menu-list {
  overflow: hidden;
  border: 1rpx solid rgba(56, 45, 35, 0.06);
  border-radius: 24rpx;
  background: #ffffff;
  box-shadow: 0 12rpx 30rpx rgba(16, 45, 32, 0.06);
}

.menu-item {
  position: relative;
  display: flex;
  align-items: center;
  justify-content: space-between;
  width: 100%;
  margin: 0;
  min-height: 126rpx;
  padding: 26rpx 28rpx;
  border-bottom: 1rpx solid rgba(56, 45, 35, 0.07);
  border-radius: 0;
  box-sizing: border-box;
  line-height: 1;
  text-align: left;
  background: #ffffff;
}

.menu-item:last-child {
  border-bottom: none;
}

.menu-item:active {
  background: rgba(24, 198, 83, 0.06);
}

.menu-item-feedback {
  background: linear-gradient(90deg, rgba(24, 198, 83, 0.07), #ffffff 58%);
}

.feedback-cover {
  position: absolute;
  inset: 0;
  z-index: 2;
  width: 100%;
  height: 100%;
  opacity: 0;
}

.menu-left {
  display: flex;
  align-items: center;
  flex: 1;
  min-width: 0;
  gap: 22rpx;
}

.menu-icon {
  display: flex;
  flex: 0 0 56rpx;
  align-items: center;
  justify-content: center;
  width: 56rpx;
  height: 56rpx;
  border-radius: 18rpx;
  background: rgba(24, 198, 83, 0.1);
}

.menu-icon-danger {
  background: rgba(229, 72, 77, 0.1);
}

.menu-icon-feedback {
  background: rgba(24, 198, 83, 0.14);
}

.menu-icon-mark {
  width: 22rpx;
  height: 22rpx;
  border: 5rpx solid #18c653;
  border-radius: 50%;
}

.menu-icon-feedback .menu-icon-mark {
  position: relative;
  width: 26rpx;
  height: 20rpx;
  border: none;
  border-radius: 10rpx;
  background: #18c653;
}

.menu-icon-feedback .menu-icon-mark::after {
  position: absolute;
  right: 4rpx;
  bottom: -5rpx;
  width: 10rpx;
  height: 10rpx;
  border-radius: 0 0 8rpx 0;
  background: #18c653;
  content: "";
}

.menu-icon-danger .menu-icon-mark {
  width: 24rpx;
  height: 5rpx;
  border: none;
  border-radius: 999rpx;
  background: #d93036;
}

.menu-copy {
  flex: 1;
  min-width: 0;
}

.menu-title {
  display: block;
  color: var(--color-text);
  font-size: 30rpx;
  font-weight: 800;
  line-height: 1.35;
}

.menu-desc {
  display: block;
  margin-top: 8rpx;
  color: var(--color-muted);
  font-size: 24rpx;
  line-height: 1.45;
}

.menu-item-danger .menu-title {
  color: #d93036;
}

.menu-arrow {
  flex: 0 0 auto;
  margin-left: auto;
  color: rgba(56, 45, 35, 0.32);
  font-size: 44rpx;
  line-height: 1;
}

.version {
  display: block;
  padding: 8rpx 0 20rpx;
  color: rgba(56, 45, 35, 0.44);
  font-size: 24rpx;
  text-align: center;
}

.guide-mask {
  position: fixed;
  inset: 0;
  z-index: 20;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 48rpx;
  background: rgba(0, 0, 0, 0.34);
}

.guide-dialog {
  display: flex;
  flex-direction: column;
  width: 100%;
  max-height: 78vh;
  overflow: hidden;
  box-sizing: border-box;
  border-radius: 28rpx;
  background: #ffffff;
  box-shadow: 0 28rpx 70rpx rgba(16, 45, 32, 0.18);
}

.guide-header {
  padding: 34rpx 34rpx 18rpx;
  text-align: center;
}

.guide-title {
  color: var(--color-text);
  font-size: 34rpx;
  font-weight: 800;
  line-height: 1.35;
}

.guide-body {
  width: 100%;
  max-height: 58vh;
  padding: 0 34rpx 20rpx;
  box-sizing: border-box;
}

.guide-section {
  padding: 22rpx 0;
  box-sizing: border-box;
  border-top: 1rpx solid rgba(56, 45, 35, 0.08);
}

.guide-section:first-child {
  border-top: none;
}

.guide-section-title {
  display: block;
  color: #0f8f3e;
  font-size: 27rpx;
  font-weight: 800;
  line-height: 1.35;
}

.guide-section-content {
  display: block;
  width: 100%;
  max-width: 100%;
  box-sizing: border-box;
  margin-top: 10rpx;
  color: rgba(56, 45, 35, 0.72);
  font-size: 27rpx;
  line-height: 1.7;
  text-align: left;
  white-space: normal;
  word-break: break-all;
  overflow-wrap: break-word;
}

.guide-confirm {
  width: 100%;
  height: 96rpx;
  border-top: 1rpx solid rgba(56, 45, 35, 0.08);
  color: #48639c;
  font-size: 30rpx;
  font-weight: 800;
  line-height: 96rpx;
  text-align: center;
  background: #ffffff;
}
