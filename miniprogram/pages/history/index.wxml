<view class="page history-page">
  <view class="section-heading">
    <text class="section-title">吃饭记录</text>
    <text class="muted">记录最近展示、跳过和采纳的推荐。</text>
  </view>

  <view class="filter-tabs">
    <button
      class="filter-tab {{activeFilter === item.value ? 'is-active' : ''}}"
      wx:for="{{filterTabs}}"
      wx:key="value"
      data-filter="{{item.value}}"
      bindtap="changeFilter"
    >
      {{item.label}}
    </button>
  </view>

  <view class="empty-state" wx:if="{{loading}}">
    <text>正在读取历史记录...</text>
  </view>

  <view class="empty-state" wx:elif="{{history.length === 0}}">
    <text>{{emptyText}}</text>
  </view>

  <view class="history-list" wx:else>
    <view class="history-item" wx:for="{{history}}" wx:key="id">
      <view class="history-main">
        <view class="history-title-row">
          <text class="meal-name">{{item.titleText}}</text>
          <view class="history-status">
            <text class="action-pill">{{item.actionText}}</text>
            <text class="date">{{item.dateText}}</text>
          </view>
        </view>
        <text class="dish-name" wx:if="{{item.subtitleText}}">{{item.subtitleText}}</text>
        <text class="note">{{item.reasonText}}</text>
        <view class="meta-row">
          <text>{{item.matchText}}</text>
        </view>
      </view>
    </view>
  </view>
</view>
