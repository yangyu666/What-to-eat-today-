.question-page {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 26rpx;
  padding: 176rpx 0 calc(32rpx + env(safe-area-inset-bottom));
  background: transparent;
}

.question-nav {
  position: relative;
  display: grid;
  grid-template-columns: 64rpx minmax(0, 1fr) 64rpx;
  align-items: center;
  width: calc(100vw - 64rpx);
  max-width: 686rpx;
  height: 88rpx;
  padding: 0 30rpx;
  border: 1rpx solid rgba(17, 24, 39, 0.05);
  border-radius: 24rpx;
  background: #ffffff;
  box-shadow: 0 8rpx 24rpx rgba(0, 0, 0, 0.08);
  overflow: hidden;
}

.icon-button,
.skip-button {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 64rpx;
  color: #111827;
}

.icon-button {
  width: 64rpx;
  border-radius: 16rpx;
  font-size: 52rpx;
  line-height: 1;
  justify-self: start;
}

.skip-button {
  position: absolute;
  top: 0;
  right: 36rpx;
  z-index: 1;
  width: 72rpx;
  height: 88rpx;
  min-width: 0;
  color: #111827;
  font-size: 28rpx;
  font-weight: 600;
  line-height: 1;
  white-space: nowrap;
}

.progress-text {
  color: #111827;
  font-size: 34rpx;
  font-weight: 700;
  text-align: center;
}

.progress-strip {
  display: grid;
  grid-template-columns: repeat(6, 1fr);
  gap: 10rpx;
  width: calc(100vw - 64rpx);
  max-width: 686rpx;
  height: 10rpx;
  margin-top: 2rpx;
}

.progress-segment {
  border-radius: 999rpx;
  background: #e5e7eb;
}

.progress-segment.is-done,
.progress-segment.is-current {
  background: #22c55e;
}

.question-header {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 14rpx;
  width: calc(100vw - 96rpx);
  max-width: 654rpx;
  padding: 34rpx 0 10rpx;
}

.question-title {
  max-width: 100%;
  color: #111827;
  font-size: 46rpx;
  font-weight: 700;
  line-height: 1.25;
  text-align: center;
}

.question-subtitle {
  max-width: 100%;
  color: #6b7280;
  font-size: 30rpx;
  line-height: 1.45;
  text-align: center;
}

.option-list {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 24rpx;
  width: 100%;
}

.option-card {
  position: relative;
  display: flex;
  flex-direction: row;
  align-items: center;
  gap: 28rpx;
  width: calc(100vw - 96rpx) !important;
  max-width: 654rpx;
  height: 190rpx;
  margin: 0 auto;
  padding: 22rpx 46rpx 22rpx 22rpx;
  border: 2rpx solid transparent;
  border-radius: 40rpx;
  color: #111827;
  text-align: left;
  background: #ffffff;
  box-shadow: 0 10rpx 28rpx rgba(0, 0, 0, 0.08);
  overflow: hidden;
  transition: transform 120ms ease, box-shadow 120ms ease, border-color 120ms ease;
}

.option-card::before {
  content: "";
  position: absolute;
  inset: 0;
  opacity: 0.72;
}

.option-card.theme-red::before {
  background: linear-gradient(90deg, #fef2f2 0%, #ffffff 78%);
}

.option-card.theme-green::before {
  background: linear-gradient(90deg, #ecfdf3 0%, #ffffff 78%);
}

.option-card.is-pressed {
  transform: scale(0.985);
  box-shadow: 0 5rpx 14rpx rgba(0, 0, 0, 0.1);
}

.option-card.theme-red.is-pressed {
  border-color: #ef4444;
}

.option-card.theme-green.is-pressed {
  border-color: #22c55e;
}

.option-image,
.option-copy,
.option-check {
  position: relative;
  z-index: 1;
}

.option-image {
  flex: 0 0 204rpx;
  width: 204rpx;
  height: 146rpx;
  border-radius: 28rpx;
  background: #f3f4f6;
  box-shadow: 0 6rpx 16rpx rgba(17, 24, 39, 0.1);
}

.option-copy {
  flex: 1 1 auto;
  min-width: 0;
  max-width: 100%;
  overflow: hidden;
}

.option-title,
.option-desc {
  display: block;
  max-width: 100%;
  overflow: hidden;
  text-overflow: ellipsis;
}

.option-title {
  font-size: 40rpx;
  font-weight: 700;
  line-height: 1.25;
  white-space: nowrap;
}

.theme-red .option-title {
  color: #ef4444;
}

.theme-green .option-title {
  color: #22c55e;
}

.option-desc {
  margin-top: 12rpx;
  color: #6b7280;
  font-size: 26rpx;
  line-height: 1.45;
  white-space: normal;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
}

.option-check {
  position: absolute;
  top: 18rpx;
  right: 18rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  width: 38rpx;
  height: 38rpx;
  border-radius: 50%;
  color: #ffffff;
  font-size: 24rpx;
  font-weight: 800;
  opacity: 0;
}

.theme-red .option-check {
  background: #ef4444;
}

.theme-green .option-check {
  background: #22c55e;
}

.option-card.is-pressed .option-check {
  opacity: 1;
}
