.food-card {
  box-sizing: border-box;
  width: 100%;
  padding: 28rpx;
  background: #ffffff;
  border-radius: 24rpx;
  box-shadow: 0 12rpx 36rpx rgba(22, 97, 56, 0.12);
  color: #1f2a24;
}

.card-head {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 20rpx;
}

.name-block {
  min-width: 0;
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.eyebrow {
  font-size: 22rpx;
  color: #18a957;
  font-weight: 600;
}

.food-name {
  font-size: 36rpx;
  line-height: 1.25;
  font-weight: 700;
  word-break: break-all;
}

.match {
  flex: 0 0 auto;
  min-width: 116rpx;
  height: 88rpx;
  border-radius: 44rpx;
  background: #eaf8ef;
  color: #12a150;
  display: flex;
  align-items: baseline;
  justify-content: center;
  padding-top: 12rpx;
  box-sizing: border-box;
}

.match-value {
  font-size: 34rpx;
  font-weight: 800;
}

.match-unit {
  font-size: 20rpx;
  font-weight: 700;
}

.meta-row {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 12rpx;
  margin-top: 24rpx;
}

.meta-item {
  min-width: 0;
  padding: 14rpx 12rpx;
  border-radius: 16rpx;
  background: #f6f8f7;
}

.meta-label,
.meta-value {
  display: block;
  text-align: center;
}

.meta-label {
  font-size: 20rpx;
  color: #7a8780;
}

.meta-value {
  margin-top: 4rpx;
  font-size: 24rpx;
  color: #24332a;
  font-weight: 650;
  word-break: break-word;
}

.tag-row {
  display: flex;
  flex-wrap: wrap;
  gap: 10rpx;
  margin-top: 22rpx;
}

.tag {
  max-width: 100%;
  padding: 8rpx 14rpx;
  border-radius: 999rpx;
  background: #eef7f1;
  color: #178448;
  font-size: 22rpx;
  line-height: 1.2;
}

.reason-list {
  margin-top: 22rpx;
  display: flex;
  flex-direction: column;
  gap: 10rpx;
}

.reason {
  display: flex;
  align-items: flex-start;
  gap: 10rpx;
}

.dot {
  width: 10rpx;
  height: 10rpx;
  margin-top: 12rpx;
  border-radius: 50%;
  background: #18c653;
  flex: 0 0 auto;
}

.reason-text {
  flex: 1;
  min-width: 0;
  color: #46544c;
  font-size: 25rpx;
  line-height: 1.5;
  word-break: break-word;
}

.fallback {
  margin-top: 20rpx;
  padding: 16rpx;
  border-radius: 16rpx;
  background: #fff7e8;
  color: #8a5a12;
  font-size: 24rpx;
  line-height: 1.45;
}

.actions {
  display: flex;
  gap: 16rpx;
  margin-top: 26rpx;
}

.btn {
  flex: 1;
  height: 84rpx;
  line-height: 84rpx;
  border-radius: 18rpx;
  font-size: 28rpx;
  font-weight: 700;
}

.btn::after {
  border: none;
}

.btn-secondary {
  color: #18a957;
  background: #edf8f1;
}

.btn-primary {
  color: #ffffff;
  background: #18c653;
  box-shadow: 0 8rpx 18rpx rgba(24, 198, 83, 0.22);
}
