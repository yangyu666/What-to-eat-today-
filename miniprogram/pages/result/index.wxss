.result-page {
  position: relative;
  display: flex;
  flex-direction: column;
  gap: 20rpx;
  min-height: 100vh;
  padding-top: 176rpx;
  background: transparent;
}

.result-back-button {
  position: absolute;
  top: 102rpx;
  left: 28rpx;
  z-index: 2;
  display: flex;
  align-items: center;
  justify-content: center;
  width: 64rpx;
  min-width: 64rpx;
  max-width: 64rpx;
  height: 56rpx;
  flex: 0 0 64rpx;
  padding: 0;
  border: 1rpx solid rgba(17, 24, 39, 0.06);
  border-radius: 999rpx;
  color: #111827;
  font-size: 42rpx;
  font-weight: 600;
  line-height: 1;
  background: rgba(255, 255, 255, 0.9);
  box-shadow: 0 10rpx 28rpx rgba(23, 31, 44, 0.06);
}

.back-chevron {
  width: 15rpx;
  height: 15rpx;
  border-left: 3rpx solid #111827;
  border-bottom: 3rpx solid #111827;
  transform: rotate(45deg);
}

.result-card {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
  padding: 0 0 24rpx;
  border: 1rpx solid var(--color-line);
  border-radius: 32rpx;
  background: #ffffff;
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.06);
  overflow: hidden;
}

.cover-wrap {
  position: relative;
  height: 302rpx;
  margin: 0;
}

.restaurant-cover {
  width: 100%;
  height: 302rpx;
  display: block;
  background: #f5f5f5;
}

.cover-placeholder {
  display: flex;
  flex-direction: column;
  justify-content: flex-end;
  width: 100%;
  height: 302rpx;
  padding: 32rpx;
  color: #ffffff;
  background: linear-gradient(135deg, #111827 0%, #6b7280 100%);
}

.placeholder-title {
  font-size: 34rpx;
  font-weight: 600;
}

.placeholder-desc {
  margin-top: 10rpx;
  max-width: 460rpx;
  color: rgba(255, 255, 255, 0.76);
  font-size: 24rpx;
  line-height: 1.4;
}

.match-badge {
  position: absolute;
  right: 0;
  bottom: -58rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  width: 144rpx;
  height: 128rpx;
  border-radius: 32rpx;
  color: #111827;
  background: #ffffff;
  box-shadow: 0 12rpx 40rpx rgba(0, 0, 0, 0.08);
}

.restaurant-name {
  display: block;
  margin: 24rpx 24rpx 0;
  color: #111827;
  font-size: 40rpx;
  font-weight: 600;
  line-height: 1.25;
}

.navigate-link {
  display: block;
  margin: -8rpx 24rpx 0;
  color: #22c55e;
  font-size: 26rpx;
  font-weight: 600;
  line-height: 1.4;
  text-align: left;
}

.match-number {
  color: #22c55e;
  font-size: 56rpx;
  font-weight: 600;
  line-height: 1;
}

.percent {
  font-size: 26rpx;
}

.match-label {
  margin-top: 8rpx;
  color: #111827;
  font-size: 28rpx;
  font-weight: 600;
}

.info-row {
  display: flex;
  align-items: center;
  gap: 18rpx;
  margin: 0 24rpx;
  color: #6b7280;
  font-size: 26rpx;
  line-height: 1.3;
}

.info-item {
  display: flex;
  align-items: center;
  gap: 8rpx;
  min-width: 0;
}

.info-icon {
  color: #6b7280;
  font-size: 26rpx;
}

.star {
  color: #f6b000;
  font-size: 28rpx;
}

.divider {
  width: 1rpx;
  height: 26rpx;
  background: #e5e7eb;
}

.reason-card {
  display: flex;
  flex-direction: column;
  gap: 18rpx;
  margin: 8rpx 24rpx 0;
  padding: 28rpx 24rpx;
  border-radius: 32rpx;
  background: #ecfdf5;
}

.reason-title {
  color: #111827;
  font-size: 30rpx;
  font-weight: 600;
}

.reason-item {
  display: flex;
  gap: 16rpx;
  padding-bottom: 16rpx;
  border-bottom: 1rpx dashed rgba(107, 114, 128, 0.18);
}

.reason-item:last-child {
  padding-bottom: 0;
  border-bottom: none;
}

.check-icon {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 32rpx;
  height: 32rpx;
  margin-top: 2rpx;
  border-radius: 50%;
  color: #ffffff;
  font-size: 22rpx;
  font-weight: 700;
  background: #22c55e;
}

.reason-copy {
  display: flex;
  flex: 1;
  flex-direction: column;
  gap: 6rpx;
  min-width: 0;
}

.reason-name {
  color: #111827;
  font-size: 28rpx;
  font-weight: 600;
  line-height: 1.25;
}

.reason-desc {
  color: #6b7280;
  font-size: 24rpx;
  line-height: 1.35;
}

.lock-card {
  display: flex;
  align-items: center;
  gap: 20rpx;
  margin: 0 24rpx;
  padding: 24rpx;
  border-radius: 32rpx;
  background: #ecfdf5;
}

.lock-icon {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 72rpx;
  height: 72rpx;
  border-radius: 50%;
  color: #ffffff;
  font-size: 34rpx;
  background: #22c55e;
}

.lock-title,
.lock-desc {
  display: block;
}

.lock-title {
  color: #22c55e;
  font-size: 28rpx;
  font-weight: 600;
}

.lock-desc {
  margin-top: 8rpx;
  color: #6b7280;
  font-size: 23rpx;
  line-height: 1.4;
}

.switch-limit {
  color: #6b7280;
  font-size: 24rpx;
  text-align: center;
}

.action-row {
  display: flex;
  flex-direction: column;
  gap: 18rpx;
  margin: 0 24rpx;
}

.primary-button,
.secondary-button {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 96rpx;
  border-radius: 48rpx;
  font-size: 32rpx;
  font-weight: 600;
}

.button-icon {
  margin-right: 12rpx;
  font-size: 30rpx;
}

.primary-button {
  color: #ffffff;
  background: linear-gradient(180deg, #22c55e 0%, #12b84d 100%);
  box-shadow: inset 0 -4rpx 8rpx rgba(0, 0, 0, 0.08), 0 12rpx 28rpx rgba(34, 197, 94, 0.24);
}

.secondary-button {
  border: 1rpx solid #e5e7eb;
  color: #111827;
  background: #ffffff;
  box-shadow: inset 0 4rpx 8rpx rgba(0, 0, 0, 0.04);
}

.primary-button[disabled],
.secondary-button[disabled] {
  border-color: transparent;
  color: #ffffff;
  background: #c8d1cb;
  box-shadow: none;
}

.empty-state {
  padding: 42rpx 36rpx;
  border: 1rpx solid var(--color-line);
  border-radius: 24rpx;
  color: #6b7280;
  text-align: center;
  background: #ffffff;
}
