.history-page {
  display: flex;
  flex-direction: column;
  gap: 32rpx;
}

.section-heading {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}

.filter-tabs {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 12rpx;
}

.filter-tab {
  display: flex;
  align-items: center;
  justify-content: center;
  min-width: 0;
  height: 68rpx;
  padding: 0 18rpx;
  border: 1rpx solid rgba(56, 45, 35, 0.1);
  border-radius: 14rpx;
  color: var(--color-muted);
  font-size: 24rpx;
  font-weight: 700;
  line-height: 1.2;
  background: rgba(255, 255, 255, 0.7);
}

.filter-tab::after {
  border: 0;
}

.filter-tab.is-active {
  border-color: rgba(255, 122, 89, 0.34);
  color: var(--color-primary);
  background: rgba(255, 122, 89, 0.12);
}

.history-list {
  display: flex;
  flex-direction: column;
  gap: 18rpx;
}

.empty-state {
  padding: 56rpx 28rpx;
  border: 1rpx dashed rgba(56, 45, 35, 0.14);
  border-radius: 18rpx;
  color: var(--color-muted);
  text-align: center;
  background: rgba(255, 255, 255, 0.58);
}

.history-item {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 24rpx;
  padding: 28rpx;
  border: 1rpx solid rgba(56, 45, 35, 0.08);
  border-radius: 18rpx;
  background: var(--color-surface);
}

.history-main {
  min-width: 0;
  flex: 1;
}

.history-title-row,
.meta-row {
  display: flex;
  align-items: center;
  gap: 14rpx;
}

.history-title-row {
  justify-content: space-between;
}

.meal-name {
  display: block;
  min-width: 0;
  color: var(--color-text);
  font-size: 30rpx;
  font-weight: 700;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.dish-name,
.note,
.date {
  display: block;
  margin-top: 8rpx;
  color: var(--color-muted);
  font-size: 24rpx;
}

.dish-name,
.note {
  line-height: 1.5;
}

.note {
  display: -webkit-box;
  overflow: hidden;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
}

.meta-row {
  flex-wrap: wrap;
  margin-top: 12rpx;
  color: var(--color-muted);
  font-size: 22rpx;
}

.action-pill {
  flex: none;
  padding: 6rpx 14rpx;
  border-radius: 999rpx;
  color: var(--color-primary);
  font-size: 22rpx;
  font-weight: 700;
  background: rgba(255, 122, 89, 0.12);
}

.date {
  flex: none;
  margin-top: 0;
  max-width: 150rpx;
  text-align: right;
}
