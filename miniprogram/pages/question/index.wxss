.question-page {
  display: flex;
  flex-direction: column;
  gap: 32rpx;
  padding-top: 24rpx;
  background: #ffffff;
}

.question-nav {
  display: grid;
  grid-template-columns: 88rpx 1fr 100rpx;
  align-items: center;
  height: 88rpx;
  padding: 0 18rpx;
  border: 1rpx solid rgba(17, 24, 39, 0.05);
  border-radius: 24rpx;
  background: #ffffff;
  box-shadow: 0 8rpx 24rpx rgba(0, 0, 0, 0.08);
}

.icon-button,
.skip-button {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 64rpx;
  color: #111827;
}

.icon-button {
  width: 64rpx;
  border-radius: 16rpx;
  font-size: 52rpx;
  line-height: 1;
}

.skip-button {
  color: #111827;
  font-size: 28rpx;
}

.progress-text {
  color: #111827;
  font-size: 34rpx;
  font-weight: 700;
  text-align: center;
}

.progress-strip {
  display: grid;
  grid-template-columns: repeat(6, 1fr);
  gap: 10rpx;
  height: 10rpx;
  margin-top: 4rpx;
}

.progress-segment {
  border-radius: 999rpx;
  background: #e5e7eb;
}

.progress-segment.is-done,
.progress-segment.is-current {
  background: #22c55e;
}

.question-header {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 16rpx;
  padding: 44rpx 12rpx 20rpx;
}

.question-title {
  color: #111827;
  font-size: 48rpx;
  font-weight: 700;
  line-height: 1.3;
  text-align: center;
}

.question-subtitle {
  color: #6b7280;
  font-size: 32rpx;
  line-height: 1.5;
  text-align: center;
}

.option-list {
  display: flex;
  flex-direction: column;
  gap: 32rpx;
}

.option-card {
  position: relative;
  display: grid;
  grid-template-columns: 168rpx 1fr;
  align-items: center;
  gap: 28rpx;
  min-height: 240rpx;
  padding: 36rpx 40rpx;
  border: 2rpx solid transparent;
  border-radius: 40rpx;
  color: #111827;
  text-align: left;
  box-shadow: 0 8rpx 24rpx rgba(0, 0, 0, 0.08);
  transition: transform 120ms ease, box-shadow 120ms ease, border-color 120ms ease;
}

.option-card.is-pressed {
  transform: scale(0.98);
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.1);
}

.option-card.theme-red {
  background: linear-gradient(90deg, #fef2f2 0%, #ffffff 78%);
}

.option-card.theme-green {
  background: linear-gradient(90deg, #ecfdf3 0%, #ffffff 78%);
}

.option-card.theme-red.is-pressed {
  border-color: #ef4444;
}

.option-card.theme-green.is-pressed {
  border-color: #22c55e;
}

.option-visual {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 144rpx;
  height: 132rpx;
  border-radius: 999rpx;
  color: #ffffff;
  font-size: 42rpx;
  font-weight: 800;
  box-shadow: inset 0 0 0 12rpx rgba(255, 255, 255, 0.28);
}

.theme-red .option-visual {
  background: radial-gradient(circle at 35% 32%, #ffd7d7 0%, #ff9b83 36%, #ef4444 72%, #b91c1c 100%);
}

.theme-green .option-visual {
  background: radial-gradient(circle at 35% 32%, #dcfce7 0%, #86efac 38%, #22c55e 72%, #15803d 100%);
}

.option-copy {
  min-width: 0;
}

.option-title,
.option-desc {
  display: block;
}

.option-title {
  font-size: 40rpx;
  font-weight: 700;
  line-height: 1.25;
}

.theme-red .option-title {
  color: #ef4444;
}

.theme-green .option-title {
  color: #22c55e;
}

.option-desc {
  margin-top: 16rpx;
  color: #6b7280;
  font-size: 26rpx;
  line-height: 1.45;
}

.option-check {
  position: absolute;
  top: 22rpx;
  right: 22rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  width: 40rpx;
  height: 40rpx;
  border-radius: 50%;
  color: #ffffff;
  font-size: 26rpx;
  font-weight: 800;
  opacity: 0;
}

.theme-red .option-check {
  background: #ef4444;
}

.theme-green .option-check {
  background: #22c55e;
}

.option-card.is-pressed .option-check {
  opacity: 1;
}
