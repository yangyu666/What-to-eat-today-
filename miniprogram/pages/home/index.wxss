.home-page {
  display: flex;
  flex-direction: column;
  gap: 30rpx;
  padding-top: 176rpx;
  background: transparent;
}

.location-row {
  display: flex;
  align-items: center;
  justify-content: flex-start;
  min-height: 54rpx;
}

.location-pill {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
  max-width: 620rpx;
  padding: 12rpx 22rpx;
  border: 1rpx solid rgba(17, 24, 39, 0.06);
  border-radius: 999rpx;
  color: #6b7280;
  font-size: 26rpx;
  line-height: 1.35;
  background: rgba(255, 255, 255, 0.78);
  box-shadow: 0 10rpx 28rpx rgba(23, 31, 44, 0.04);
}

.location-dot {
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
  background: var(--color-accent);
  box-shadow: 0 0 0 8rpx rgba(24, 198, 83, 0.1);
}

.intro {
  display: flex;
  flex-direction: column;
  align-items: flex-start;
  gap: 14rpx;
  padding: 48rpx 0 18rpx;
  text-align: left;
}

.hero {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 0 12rpx 18rpx;
  text-align: center;
}

.greeting {
  color: #111827;
  font-size: 34rpx;
  font-weight: 700;
  line-height: 1.35;
}

.title {
  margin-top: 4rpx;
  color: #111827;
  font-size: 72rpx;
  font-weight: 800;
  line-height: 1.12;
}

.accent {
  color: var(--color-accent);
}

.subtitle {
  color: #8a93a3;
  font-size: 30rpx;
  line-height: 1.45;
}

.action-panel {
  display: flex;
  align-items: center;
  justify-content: center;
  margin: 2rpx 0 0;
}

.primary-button {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 456rpx;
  max-width: 100%;
  height: 100rpx;
  border-radius: 26rpx;
  font-size: 30rpx;
  font-weight: 700;
  line-height: 1.3;
  color: #ffffff;
  background: linear-gradient(180deg, #20d866 0%, var(--color-accent) 100%);
  box-shadow: 0 18rpx 40rpx rgba(24, 198, 83, 0.28);
}

.history-filter-card {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 24rpx;
  padding: 24rpx 28rpx 24rpx 24rpx;
  border: 1rpx solid rgba(17, 24, 39, 0.06);
  border-radius: 28rpx;
  background:
    linear-gradient(90deg, rgba(24, 198, 83, 0.06), rgba(255, 255, 255, 0) 56%),
    rgba(255, 255, 255, 0.92);
  box-shadow: 0 16rpx 38rpx rgba(16, 45, 32, 0.07);
}

.card-left {
  display: flex;
  align-items: center;
  min-width: 0;
  gap: 20rpx;
}

.home-card-icon {
  position: relative;
  display: flex;
  flex: 0 0 64rpx;
  align-items: center;
  justify-content: center;
  width: 64rpx;
  height: 64rpx;
  border-radius: 20rpx;
  overflow: hidden;
  color: #18c653;
  font-size: 24rpx;
  font-weight: 900;
  line-height: 1;
  background: rgba(24, 198, 83, 0.1);
}

.home-card-icon::after {
  position: absolute;
  right: -12rpx;
  bottom: -14rpx;
  width: 40rpx;
  height: 40rpx;
  border-radius: 50%;
  background: rgba(24, 198, 83, 0.12);
  content: '';
}

.filter-card-icon {
  color: #ffffff;
  background: linear-gradient(135deg, #22c55e 0%, #16a34a 100%);
  box-shadow: 0 10rpx 24rpx rgba(24, 198, 83, 0.2);
}

.history-card-icon {
  color: #f5a524;
  background: rgba(245, 166, 35, 0.12);
}

.home-card-icon-image {
  position: relative;
  z-index: 1;
  width: 68rpx;
  height: 68rpx;
  border-radius: 20rpx;
}

.history-glyph {
  position: relative;
  z-index: 1;
  width: 34rpx;
  height: 34rpx;
  border: 5rpx solid #f5a524;
  border-radius: 50%;
  box-sizing: border-box;
}

.history-glyph::before,
.history-glyph::after {
  position: absolute;
  left: 13rpx;
  top: 7rpx;
  width: 5rpx;
  height: 10rpx;
  border-radius: 999rpx;
  background: #f5a524;
  content: '';
}

.history-glyph::after {
  top: 15rpx;
  left: 15rpx;
  width: 10rpx;
  height: 5rpx;
}

.history-filter-copy {
  min-width: 0;
}

.history-filter-title,
.history-filter-desc {
  display: block;
}

.history-filter-title {
  color: #111827;
  font-size: 29rpx;
  font-weight: 800;
  line-height: 1.35;
}

.history-filter-desc {
  margin-top: 6rpx;
  color: #8a93a3;
  font-size: 24rpx;
  line-height: 1.4;
}

.history-filter-switch {
  flex: 0 0 auto;
  transform: scale(0.86);
  transform-origin: right center;
}

.history-entry {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 26rpx 28rpx 26rpx 24rpx;
  border: 1rpx solid rgba(17, 24, 39, 0.05);
  border-radius: 28rpx;
  background: rgba(255, 255, 255, 0.94);
  box-shadow: 0 12rpx 30rpx rgba(16, 45, 32, 0.05);
}

.history-entry:active {
  background: rgba(24, 198, 83, 0.05);
}

.entry-title,
.entry-desc,
.meal-name,
.meal-time {
  display: block;
}

.entry-title {
  color: var(--color-text);
  font-size: 30rpx;
  font-weight: 700;
}

.entry-desc {
  margin-top: 8rpx;
  color: var(--color-muted);
  font-size: 24rpx;
}

.entry-arrow {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 42rpx;
  height: 42rpx;
  border-radius: 50%;
  color: rgba(17, 24, 39, 0.36);
  font-size: 42rpx;
  line-height: 1;
  background: rgba(17, 24, 39, 0.04);
}

.recent-section {
  margin-top: 12rpx;
}

.section-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 18rpx;
}

.section-title-wrap {
  display: flex;
  align-items: center;
  gap: 14rpx;
}

.section-icon {
  position: relative;
  display: flex;
  flex: 0 0 30rpx;
  align-items: center;
  justify-content: center;
  width: 30rpx;
  height: 34rpx;
  background: transparent;
}

.section-icon::before,
.section-icon::after {
  position: absolute;
  content: '';
}

.section-icon::before {
  top: 50%;
  left: 0;
  width: 10rpx;
  height: 34rpx;
  border-radius: 999rpx;
  background: #18c653;
  box-shadow: 0 8rpx 18rpx rgba(24, 198, 83, 0.2);
  transform: translateY(-50%);
}

.section-icon::after {
  top: 50%;
  right: 2rpx;
  width: 8rpx;
  height: 8rpx;
  border-radius: 50%;
  background: #18c653;
  transform: translateY(-50%);
}

.section-title {
  color: var(--color-text);
  font-size: 30rpx;
  font-weight: 800;
}

.section-link {
  color: var(--color-muted);
  font-size: 26rpx;
}

.recent-list {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 16rpx;
}

.recent-empty {
  display: flex;
  align-items: center;
  gap: 18rpx;
  min-height: 118rpx;
  padding: 26rpx 28rpx;
  border: 1rpx dashed rgba(24, 198, 83, 0.22);
  border-radius: 26rpx;
  color: #8a93a3;
  font-size: 26rpx;
  line-height: 1.45;
  background:
    linear-gradient(90deg, rgba(24, 198, 83, 0.06), rgba(255, 255, 255, 0) 58%),
    rgba(255, 255, 255, 0.72);
}

.recent-empty-icon {
  display: flex;
  flex: 0 0 54rpx;
  align-items: center;
  justify-content: center;
  width: 54rpx;
  height: 54rpx;
  border-radius: 18rpx;
  background: rgba(24, 198, 83, 0.12);
}

.recent-empty-icon .recommend-glyph {
  position: relative;
  width: 26rpx;
  height: 18rpx;
  border: 4rpx solid #18c653;
  border-top: none;
  border-radius: 0 0 999rpx 999rpx;
  box-sizing: border-box;
}

.recent-empty-icon .recommend-glyph::before,
.recent-empty-icon .recommend-glyph::after {
  position: absolute;
  top: -11rpx;
  width: 4rpx;
  height: 10rpx;
  border-radius: 999rpx;
  background: #18c653;
  content: '';
}

.recent-empty-icon .recommend-glyph::before {
  left: 5rpx;
}

.recent-empty-icon .recommend-glyph::after {
  right: 5rpx;
}

.recent-card {
  min-width: 0;
}

.meal-cover {
  position: relative;
  display: flex;
  align-items: flex-start;
  justify-content: flex-end;
  height: 168rpx;
  padding: 12rpx;
  border-radius: 18rpx;
  color: var(--color-accent);
  font-size: 22rpx;
  font-weight: 700;
  background: linear-gradient(135deg, #f8d4ce 0%, #b33d31 100%);
  overflow: hidden;
}

.meal-cover-image {
  position: absolute;
  inset: 0;
  width: 100%;
  height: 100%;
}

.meal-cover::after {
  position: absolute;
  inset: 0;
  content: '';
  background: linear-gradient(180deg, rgba(0, 0, 0, 0.08), rgba(0, 0, 0, 0.22));
}

.meal-cover text {
  position: relative;
  z-index: 1;
  padding: 6rpx 8rpx;
  border-radius: 10rpx;
  background: rgba(255, 255, 255, 0.88);
}

.meal-cover.is-orange {
  background: linear-gradient(135deg, #ffe2b8 0%, #be6b22 100%);
}

.meal-cover.is-green {
  background: linear-gradient(135deg, #d9f4de 0%, #309c53 100%);
}

.meal-name {
  margin-top: 12rpx;
  color: var(--color-text);
  font-size: 25rpx;
  font-weight: 700;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.meal-time {
  margin-top: 6rpx;
  color: var(--color-muted);
  font-size: 23rpx;
}
