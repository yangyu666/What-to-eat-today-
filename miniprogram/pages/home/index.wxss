.home-page {
  display: flex;
  flex-direction: column;
  gap: 32rpx;
}

.hero {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
  padding-top: 16rpx;
}

.eyebrow {
  color: var(--color-accent);
  font-size: 24rpx;
  font-weight: 700;
  letter-spacing: 2rpx;
}

.title {
  color: var(--color-text);
  font-size: 56rpx;
  font-weight: 800;
  line-height: 1.18;
}

.subtitle {
  max-width: 620rpx;
  color: var(--color-muted);
  font-size: 28rpx;
  line-height: 1.6;
}

.recommend-card,
.empty-state {
  padding: 36rpx;
  border: 1rpx solid rgba(56, 45, 35, 0.08);
  border-radius: 24rpx;
  background: var(--color-surface);
  box-shadow: 0 16rpx 40rpx rgba(76, 55, 32, 0.08);
}

.card-label {
  color: var(--color-muted);
  font-size: 24rpx;
}

.meal-name {
  display: block;
  margin-top: 12rpx;
  color: var(--color-text);
  font-size: 48rpx;
  font-weight: 800;
  line-height: 1.3;
}

.tag-row {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-top: 24rpx;
}

.tag {
  padding: 8rpx 16rpx;
  border-radius: 999rpx;
  color: var(--color-accent);
  font-size: 24rpx;
  background: rgba(217, 95, 53, 0.1);
}

.reason {
  display: block;
  margin-top: 28rpx;
  color: var(--color-text);
  font-size: 30rpx;
  line-height: 1.65;
}

.meta-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 24rpx;
  margin-top: 32rpx;
  color: var(--color-muted);
  font-size: 26rpx;
}

.text-button {
  min-width: 144rpx;
  padding: 16rpx 24rpx;
  border-radius: 999rpx;
  color: #ffffff;
  font-size: 28rpx;
  line-height: 1.3;
  background: var(--color-accent);
}

.empty-state {
  color: var(--color-muted);
  text-align: center;
}
