<view class="page result-page">
  <view class="empty-state" wx:if="{{loading}}">
    <text>正在匹配附近适合的一家...</text>
  </view>

  <view class="result-card" wx:elif="{{recommendation}}">
    <view class="cover-wrap">
      <image
        wx:if="{{coverImageUrl}}"
        class="restaurant-cover"
        mode="aspectFill"
        src="{{coverImageUrl}}"
        binderror="handleCoverImageError"
      />
      <view class="cover-placeholder" wx:else>
        <text class="placeholder-title">暂无门店图片</text>
        <text class="placeholder-desc">优先使用高德 POI 或本地餐厅图片</text>
      </view>
      <view class="match-badge">
        <text class="match-number">{{matchPercent}}<text class="percent">%</text></text>
        <text class="match-label">匹配度</text>
      </view>
    </view>

    <text class="restaurant-name">{{recommendation.restaurant.name}}</text>
    <text class="meal-name">推荐：{{mealNameText}}</text>

    <text class="source-text">{{sourceText}}</text>

    <view class="info-row">
      <view class="info-item">
        <text class="info-icon">距</text>
        <text>{{walkText}}</text>
      </view>
      <view class="divider"></view>
      <view class="info-item">
        <text class="info-icon">¥</text>
        <text>{{averageCostText}}</text>
      </view>
      <view class="divider"></view>
      <view class="info-item">
        <text class="star">★</text>
        <text>{{ratingText}}</text>
      </view>
    </view>

    <view class="reason-card">
      <text class="reason-title">推荐理由</text>
      <view
        class="reason-item"
        wx:for="{{reasonItems}}"
        wx:key="title"
      >
        <text class="check-icon">✓</text>
        <view class="reason-copy">
          <text class="reason-name">{{item.title}}</text>
          <text class="reason-desc">{{item.desc}}</text>
        </view>
      </view>
    </view>

    <view class="lock-card" wx:if="{{locked && !accepted}}">
      <view class="lock-icon">锁</view>
      <view>
        <text class="lock-title">已为你锁定当前推荐</text>
        <text class="lock-desc">多次刷新后，保留当前最匹配方案</text>
      </view>
    </view>

    <view class="switch-limit" wx:else>
      <text wx:if="{{accepted}}">已采纳，这一餐定了。</text>
      <text wx:elif="{{switchCount >= maxSwitchCount}}">已换 3 次，当前结果已锁定。</text>
      <text wx:else>还可以换 {{maxSwitchCount - switchCount}} 次</text>
    </view>

    <view class="action-row">
      <button class="secondary-button" bindtap="switchRestaurant" disabled="{{locked || accepted}}">
        <text class="button-icon">↻</text>
        {{locked || accepted ? '已锁定' : switchButtonText}}
      </button>
      <button class="primary-button" bindtap="acceptRestaurant" disabled="{{accepted}}">
        <text class="button-icon">✓</text>
        {{accepted ? '已采纳' : '就吃这家'}}
      </button>
    </view>
  </view>

  <view class="empty-state" wx:else>
    <text>{{errorText || '推荐加载失败，请稍后重试'}}</text>
  </view>
</view>
