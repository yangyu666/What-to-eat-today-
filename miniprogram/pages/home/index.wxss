.home-page {
  display: flex;
  flex-direction: column;
  gap: 30rpx;
  background: var(--color-page);
}

.location-row {
  display: flex;
  align-items: center;
  justify-content: center;
  min-height: 54rpx;
}

.location-pill {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
  max-width: 620rpx;
  padding: 12rpx 22rpx;
  border: 1rpx solid rgba(17, 24, 39, 0.06);
  border-radius: 999rpx;
  color: #6b7280;
  font-size: 26rpx;
  line-height: 1.35;
  background: rgba(255, 255, 255, 0.78);
  box-shadow: 0 10rpx 28rpx rgba(23, 31, 44, 0.04);
}

.location-dot {
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
  background: var(--color-accent);
  box-shadow: 0 0 0 8rpx rgba(24, 198, 83, 0.1);
}

.hero {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 14rpx;
  padding: 48rpx 12rpx 18rpx;
  text-align: center;
}

.greeting {
  color: #111827;
  font-size: 34rpx;
  font-weight: 700;
  line-height: 1.35;
}

.title {
  margin-top: 4rpx;
  color: #111827;
  font-size: 72rpx;
  font-weight: 800;
  line-height: 1.12;
}

.accent {
  color: var(--color-accent);
}

.subtitle {
  color: #8a93a3;
  font-size: 30rpx;
  line-height: 1.45;
}

.action-panel {
  display: flex;
  align-items: center;
  justify-content: center;
  margin: 2rpx 0 0;
}

.primary-button {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 456rpx;
  max-width: 100%;
  height: 100rpx;
  border-radius: 26rpx;
  font-size: 30rpx;
  font-weight: 700;
  line-height: 1.3;
  color: #ffffff;
  background: linear-gradient(180deg, #20d866 0%, var(--color-accent) 100%);
  box-shadow: 0 18rpx 40rpx rgba(24, 198, 83, 0.28);
}

.history-filter-card {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 24rpx;
  padding: 24rpx 28rpx;
  border: 1rpx solid rgba(17, 24, 39, 0.06);
  border-radius: 26rpx;
  background: rgba(255, 255, 255, 0.86);
  box-shadow: 0 14rpx 34rpx rgba(23, 31, 44, 0.06);
}

.history-filter-copy {
  min-width: 0;
}

.history-filter-title,
.history-filter-desc {
  display: block;
}

.history-filter-title {
  color: #111827;
  font-size: 29rpx;
  font-weight: 800;
  line-height: 1.35;
}

.history-filter-desc {
  margin-top: 6rpx;
  color: #8a93a3;
  font-size: 24rpx;
  line-height: 1.4;
}

.history-filter-switch {
  flex: 0 0 auto;
  transform: scale(0.86);
  transform-origin: right center;
}

.history-entry {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 26rpx 28rpx;
  border: 1rpx solid var(--color-line);
  border-radius: 22rpx;
  background: var(--color-surface);
}

.entry-title,
.entry-desc,
.meal-name,
.meal-time {
  display: block;
}

.entry-title {
  color: var(--color-text);
  font-size: 30rpx;
  font-weight: 700;
}

.entry-desc {
  margin-top: 8rpx;
  color: var(--color-muted);
  font-size: 24rpx;
}

.entry-arrow {
  color: var(--color-muted);
  font-size: 42rpx;
}

.recent-section {
  margin-top: 12rpx;
}

.section-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 18rpx;
}

.section-title {
  color: var(--color-text);
  font-size: 30rpx;
  font-weight: 800;
}

.section-link {
  color: var(--color-muted);
  font-size: 26rpx;
}

.recent-list {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 16rpx;
}

.recent-card {
  min-width: 0;
}

.meal-cover {
  position: relative;
  display: flex;
  align-items: flex-start;
  justify-content: flex-end;
  height: 168rpx;
  padding: 12rpx;
  border-radius: 18rpx;
  color: var(--color-accent);
  font-size: 22rpx;
  font-weight: 700;
  background: linear-gradient(135deg, #f8d4ce 0%, #b33d31 100%);
  overflow: hidden;
}

.meal-cover-image {
  position: absolute;
  inset: 0;
  width: 100%;
  height: 100%;
}

.meal-cover::after {
  position: absolute;
  inset: 0;
  content: '';
  background: linear-gradient(180deg, rgba(0, 0, 0, 0.08), rgba(0, 0, 0, 0.22));
}

.meal-cover text {
  position: relative;
  z-index: 1;
  padding: 6rpx 8rpx;
  border-radius: 10rpx;
  background: rgba(255, 255, 255, 0.88);
}

.meal-cover.is-orange {
  background: linear-gradient(135deg, #ffe2b8 0%, #be6b22 100%);
}

.meal-cover.is-green {
  background: linear-gradient(135deg, #d9f4de 0%, #309c53 100%);
}

.meal-name {
  margin-top: 12rpx;
  color: var(--color-text);
  font-size: 25rpx;
  font-weight: 700;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.meal-time {
  margin-top: 6rpx;
  color: var(--color-muted);
  font-size: 23rpx;
}
