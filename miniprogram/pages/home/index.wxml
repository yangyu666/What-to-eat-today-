<view class="page home-page">
  <view class="location-row">
    <view class="location-pill" bindtap="initLocation">
      <text class="location-dot"></text>
      <text>{{locationStatus}}</text>
    </view>
  </view>

  <view class="intro">
    <text class="greeting">Hi, {{userName}} 👋</text>
    <text class="subtitle">今天想吃点什么呢？</text>
  </view>

  <view class="hero">
    <text class="title">今天吃<text class="accent">什么</text>？</text>
  </view>

  <view class="action-panel">
    <button class="primary-button" bindtap="startQuestionnaire">帮我决定</button>
  </view>

  <view class="history-filter-card">
    <view class="card-left">
      <view class="home-card-icon filter-card-icon">
        <image class="home-card-icon-image" src="/assets/icons/recommend.png" mode="aspectFit" />
      </view>
      <view class="history-filter-copy">
        <text class="history-filter-title">避开最近推荐</text>
        <text class="history-filter-desc">开启后优先换新选择</text>
      </view>
    </view>
    <switch
      class="history-filter-switch"
      checked="{{historyFilterEnabled}}"
      color="#18c653"
      bindchange="toggleHistoryFilter"
    />
  </view>

  <view class="history-entry" bindtap="openHistory">
    <view class="card-left">
      <view class="home-card-icon history-card-icon">
        <view class="history-glyph"></view>
      </view>
      <view>
        <text class="entry-title">历史记录</text>
        <text class="entry-desc">查看之前吃过和推荐过的选择</text>
      </view>
    </view>
    <text class="entry-arrow">›</text>
  </view>

  <view class="recent-section">
    <view class="section-header">
      <view class="section-title-wrap">
        <view class="section-icon"></view>
        <text class="section-title">最近推荐</text>
      </view>
      <text class="section-link" bindtap="openHistory">查看全部 ›</text>
    </view>
    <view class="recent-empty" wx:if="{{recentMeals.length === 0}}">
      <view class="recent-empty-icon">
        <view class="recommend-glyph empty-recommend-glyph"></view>
      </view>
      <text>还没有记录，快去决定第一顿吧！</text>
    </view>
    <view class="recent-list" wx:else>
      <view class="recent-card" wx:for="{{recentMeals}}" wx:key="id">
        <view class="meal-cover">
          <image class="meal-cover-image" src="{{item.imageUrl}}" mode="aspectFill" lazy-load="true" />
          <text>{{item.matchText}}</text>
        </view>
        <text class="meal-name">{{item.name}}</text>
        <text class="meal-time">{{item.timeText}}</text>
      </view>
    </view>
  </view>

  <view class="privacy-mask" wx:if="{{privacyConsentVisible}}" catchtouchmove="noop">
    <view class="privacy-dialog">
      <view class="privacy-badge">
        <text class="privacy-badge-dot"></text>
      </view>
      <text class="privacy-title">位置使用说明</text>
      <text class="privacy-intro">我们会在你同意后获取当前位置，仅用于查询附近美食。</text>
      <view class="privacy-points">
        <text>位置信息仅用于当次推荐美食和附近美食查询，不会用于广告追踪。</text>
        <text>我们不会保存你的精确定位到用户资料中。</text>
        <text>为获取附近美食信息，系统可能会基于当前位置请求地图服务。</text>
      </view>
      <text class="privacy-warning" wx:if="{{privacyRejectMessage}}">{{privacyRejectMessage}}</text>
      <view class="privacy-actions">
        <button class="privacy-button secondary" bindtap="rejectPrivacyConsent">拒绝并退出</button>
        <button class="privacy-button primary" bindtap="acceptPrivacyConsent">接受并进入</button>
      </view>
    </view>
  </view>
</view>
