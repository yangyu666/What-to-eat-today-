.preferences-page {
  display: flex;
  flex-direction: column;
  gap: 32rpx;
}

.section-heading {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}

.option-list {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

.option {
  min-width: 190rpx;
  padding: 22rpx 28rpx;
  border: 1rpx solid rgba(56, 45, 35, 0.12);
  border-radius: 18rpx;
  color: var(--color-text);
  font-size: 28rpx;
  line-height: 1.3;
  text-align: center;
  background: var(--color-surface);
}

.option.is-selected {
  border-color: rgba(217, 95, 53, 0.45);
  color: var(--color-accent);
  background: rgba(217, 95, 53, 0.1);
}
