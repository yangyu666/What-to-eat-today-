.mine-page {
  display: flex;
  flex-direction: column;
  gap: 32rpx;
}

.profile {
  display: flex;
  align-items: center;
  gap: 24rpx;
  padding: 32rpx;
  border-radius: 24rpx;
  background: var(--color-surface);
}

.avatar {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 96rpx;
  height: 96rpx;
  border-radius: 50%;
  color: #ffffff;
  font-size: 40rpx;
  font-weight: 800;
  background: var(--color-accent);
}

.nickname {
  display: block;
  color: var(--color-text);
  font-size: 34rpx;
  font-weight: 700;
}

.status {
  display: block;
  margin-top: 8rpx;
  color: var(--color-muted);
  font-size: 24rpx;
}

.info-panel {
  padding: 30rpx;
  border: 1rpx solid rgba(56, 45, 35, 0.08);
  border-radius: 18rpx;
  background: var(--color-surface);
}

.panel-title {
  display: block;
  color: var(--color-text);
  font-size: 30rpx;
  font-weight: 700;
}

.panel-text {
  display: block;
  margin-top: 14rpx;
  color: var(--color-muted);
  font-size: 26rpx;
  line-height: 1.65;
}
