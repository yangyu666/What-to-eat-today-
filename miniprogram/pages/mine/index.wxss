.mine-page {
  display: flex;
  flex-direction: column;
  gap: 28rpx;
}

.profile-card {
  display: flex;
  align-items: center;
  gap: 24rpx;
  padding: 32rpx;
  border: 1rpx solid rgba(56, 45, 35, 0.06);
  border-radius: 24rpx;
  background: var(--color-surface);
  box-shadow: 0 12rpx 32rpx rgba(16, 45, 32, 0.08);
}

.avatar-button {
  flex: 0 0 112rpx;
  width: 112rpx;
  height: 112rpx;
  overflow: hidden;
  border-radius: 50%;
  background: rgba(24, 198, 83, 0.1);
}

.avatar-image,
.avatar-placeholder {
  width: 112rpx;
  height: 112rpx;
  border-radius: 50%;
}

.avatar-placeholder {
  display: flex;
  align-items: center;
  justify-content: center;
  color: #ffffff;
  font-size: 38rpx;
  font-weight: 800;
  background: linear-gradient(135deg, #18c653, #10a947);
}

.profile-main {
  flex: 1;
  min-width: 0;
}

.nickname-input {
  width: 100%;
  height: 48rpx;
  color: var(--color-text);
  font-size: 34rpx;
  font-weight: 800;
  line-height: 48rpx;
}

.status {
  display: block;
  margin-top: 8rpx;
  color: var(--color-muted);
  font-size: 24rpx;
  line-height: 1.45;
}

.menu-list {
  overflow: hidden;
  border: 1rpx solid rgba(56, 45, 35, 0.06);
  border-radius: 22rpx;
  background: var(--color-surface);
  box-shadow: 0 10rpx 28rpx rgba(16, 45, 32, 0.06);
}

.menu-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
  width: 100%;
  min-height: 116rpx;
  padding: 24rpx 28rpx;
  border-bottom: 1rpx solid rgba(56, 45, 35, 0.07);
  text-align: left;
  background: #ffffff;
}

.menu-item:last-child {
  border-bottom: none;
}

.menu-item:active {
  background: rgba(24, 198, 83, 0.06);
}

.menu-copy {
  flex: 1;
  min-width: 0;
}

.menu-title {
  display: block;
  color: var(--color-text);
  font-size: 29rpx;
  font-weight: 700;
  line-height: 1.35;
}

.menu-desc {
  display: block;
  margin-top: 8rpx;
  color: var(--color-muted);
  font-size: 24rpx;
  line-height: 1.45;
}

.menu-item-danger .menu-title {
  color: #d93036;
}

.menu-arrow {
  flex: 0 0 auto;
  color: rgba(56, 45, 35, 0.32);
  font-size: 44rpx;
  line-height: 1;
}

.version {
  display: block;
  padding: 8rpx 0 20rpx;
  color: var(--color-muted);
  font-size: 24rpx;
  text-align: center;
}
