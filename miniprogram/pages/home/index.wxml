<view class="page home-page">
  <view class="top-row">
    <view class="location-pill">
      <text class="location-dot">●</text>
      <text>{{locationStatus}}</text>
    </view>
    <view class="weather-card">
      <text class="weather-icon">☀</text>
      <text>26°C</text>
    </view>
  </view>

  <view class="hero">
    <text class="greeting">Hi，小明 👋</text>
    <text class="subtitle">中午好，今天想吃点什么呢？</text>
    <text class="title">今天吃<text class="accent">什么</text>？</text>
    <text class="hero-note"><text class="accent">30秒</text>结束选择困难</text>
  </view>

  <view class="action-panel">
    <button class="primary-button" bindtap="startQuestionnaire">帮我决定</button>
    <button class="secondary-button" bindtap="startQuestionnaire">我有要求</button>
  </view>

  <view class="history-entry" bindtap="openHistory">
    <view>
      <text class="entry-title">历史记录</text>
      <text class="entry-desc">查看之前吃过和推荐过的选择</text>
    </view>
    <text class="entry-arrow">›</text>
  </view>

  <view class="recent-section">
    <view class="section-header">
      <text class="section-title">最近推荐</text>
      <text class="section-link" bindtap="openHistory">查看全部 ›</text>
    </view>
    <view class="recent-list">
      <view class="recent-card" wx:for="{{recentMeals}}" wx:key="id">
        <view class="meal-cover {{item.coverClass}}">
          <text>{{item.matchText}}</text>
        </view>
        <text class="meal-name">{{item.name}}</text>
        <text class="meal-time">{{item.timeText}}</text>
      </view>
    </view>
  </view>
</view>
