.home-page {
  display: flex;
  flex-direction: column;
  gap: 28rpx;
  background: var(--color-page);
}

.top-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
}

.location-pill,
.weather-card {
  display: flex;
  align-items: center;
  gap: 10rpx;
  color: var(--color-text);
  font-size: 26rpx;
}

.location-dot {
  color: var(--color-text);
  font-size: 20rpx;
}

.weather-card {
  padding: 14rpx 18rpx;
  border: 1rpx solid var(--color-line);
  border-radius: 18rpx;
  background: var(--color-surface);
  box-shadow: 0 10rpx 28rpx rgba(23, 31, 44, 0.06);
}

.weather-icon {
  color: #f5b521;
}

.hero {
  display: flex;
  flex-direction: column;
  gap: 14rpx;
  padding-top: 30rpx;
}

.greeting {
  color: var(--color-text);
  font-size: 32rpx;
  font-weight: 700;
}

.title {
  color: var(--color-text);
  font-size: 66rpx;
  font-weight: 800;
  line-height: 1.12;
}

.accent {
  color: var(--color-accent);
}

.subtitle,
.hero-note {
  color: var(--color-muted);
  font-size: 28rpx;
  line-height: 1.45;
}

.action-panel {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
  margin-top: 8rpx;
}

.primary-button,
.secondary-button {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 100rpx;
  border-radius: 24rpx;
  font-size: 30rpx;
  font-weight: 700;
  line-height: 1.3;
}

.primary-button {
  color: #ffffff;
  background: linear-gradient(180deg, #20d866 0%, var(--color-accent) 100%);
  box-shadow: 0 18rpx 40rpx rgba(24, 198, 83, 0.28);
}

.secondary-button {
  border: 1rpx solid var(--color-line);
  color: var(--color-text);
  background: var(--color-surface);
  box-shadow: 0 12rpx 28rpx rgba(23, 31, 44, 0.05);
}

.history-entry {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 26rpx 28rpx;
  border: 1rpx solid var(--color-line);
  border-radius: 22rpx;
  background: var(--color-surface);
}

.entry-title,
.entry-desc,
.meal-name,
.meal-time {
  display: block;
}

.entry-title {
  color: var(--color-text);
  font-size: 30rpx;
  font-weight: 700;
}

.entry-desc {
  margin-top: 8rpx;
  color: var(--color-muted);
  font-size: 24rpx;
}

.entry-arrow {
  color: var(--color-muted);
  font-size: 42rpx;
}

.recent-section {
  margin-top: 12rpx;
}

.section-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 18rpx;
}

.section-title {
  color: var(--color-text);
  font-size: 30rpx;
  font-weight: 800;
}

.section-link {
  color: var(--color-muted);
  font-size: 26rpx;
}

.recent-list {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 16rpx;
}

.recent-card {
  min-width: 0;
}

.meal-cover {
  position: relative;
  display: flex;
  align-items: flex-start;
  justify-content: flex-end;
  height: 168rpx;
  padding: 12rpx;
  border-radius: 18rpx;
  color: var(--color-accent);
  font-size: 22rpx;
  font-weight: 700;
  background: linear-gradient(135deg, #f8d4ce 0%, #b33d31 100%);
  overflow: hidden;
}

.meal-cover-image {
  position: absolute;
  inset: 0;
  width: 100%;
  height: 100%;
}

.meal-cover::after {
  position: absolute;
  inset: 0;
  content: '';
  background: linear-gradient(180deg, rgba(0, 0, 0, 0.08), rgba(0, 0, 0, 0.22));
}

.meal-cover text {
  position: relative;
  z-index: 1;
  padding: 6rpx 8rpx;
  border-radius: 10rpx;
  background: rgba(255, 255, 255, 0.88);
}

.meal-cover.is-orange {
  background: linear-gradient(135deg, #ffe2b8 0%, #be6b22 100%);
}

.meal-cover.is-green {
  background: linear-gradient(135deg, #d9f4de 0%, #309c53 100%);
}

.meal-name {
  margin-top: 12rpx;
  color: var(--color-text);
  font-size: 25rpx;
  font-weight: 700;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.meal-time {
  margin-top: 6rpx;
  color: var(--color-muted);
  font-size: 23rpx;
}
